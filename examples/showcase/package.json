{
  "name": "powersync-lynx-showcase",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "bundle-factory": "pnpm --dir ../.. bundle-factory",
    "build": "pnpm bundle-factory && rspeedy build",
    "build:host": "pnpm bundle-factory && vite build --config host/vite.config.ts",
    "dev:web": "pnpm bundle-factory && rspeedy build && vite --config host/vite.config.ts",
    "preview:web": "pnpm build && pnpm build:host && vite preview --config host/vite.config.ts",
    "typecheck": "tsc -b tsconfig.json && tsc -p host/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/react": "^0.129.4",
    "@lynx-js/web-core": "^0.26.9",
    "@powersync/common": "^2.5.0",
    "@powersync/web": "^2.7.0",
    "powersync-lynx": "link:../.."
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "5.0.1-20261123125323-a3af24e",
    "@lynx-js/react-rsbuild-plugin": "^0.22.4",
    "@lynx-js/rspeedy": "^0.19.0",
    "@lynx-js/types": "4.4.2",
    "@rsbuild/plugin-type-check": "1.6.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
