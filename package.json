{
  "name": "powersync-lynx",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "files": [
    "src",
    "lynxtron",
    "android/src",
    "android/build.gradle",
    "android/gradle.properties",
    "android/consumer-rules.pro",
    "ios/src",
    "ios/src/ps_sql.cc",
    "ios/src/ps_sql.h",
    "ios/src/sqlite3.c",
    "ios/src/sqlite3.h",
    "ios/powersync-lynx.podspec",
    "shared/ps_sql.cc",
    "shared/ps_sql.h",
    "shared/sync_http_policy.h",
    "shared/utf8_hold.h",
    "shared/nativeModule",
    "shared/win_host_stubs.c",
    "shared/CMakeLists.txt",
    "dist",
    "lynx.lib.json",
    "scripts",
    "third_party/sqlite/sqlite3.c",
    "third_party/sqlite/sqlite3.h"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web-host": "./src/web-host/index.ts",
    "./lynxtron": "./lynxtron/index.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm typecheck && node scripts/bundle-web-host-factory.mjs && node scripts/fetch-native-deps.mjs --sqlite",
    "bundle-factory": "node scripts/bundle-web-host-factory.mjs",
    "prepare": "node scripts/bundle-web-host-factory.mjs",
    "publish-dry-run": "node examples/scripts/publish-dry-run.mjs"
  },
  "dependencies": {
    "@powersync/common": "^2.2.0",
    "@powersync/shared-internals": "^1.2.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "26.4.1",
    "esbuild": "0.27.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "@powersync/common": "^2.2.0",
    "@powersync/web": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "@powersync/web": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
