{
  "name": "powersync-lynx",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "lib",
    "lynxtron",
    "android",
    "ios",
    "shared",
    "dist",
    "lynx.lib.json"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web-host": {
      "types": "./lib/web-host/index.d.ts",
      "default": "./lib/web-host/index.js"
    },
    "./lynxtron": "./lynxtron/index.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@powersync/common": "^2.2.0",
    "@powersync/shared-internals": "^1.2.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "26.4.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@powersync/common": "^2.2.0",
    "@powersync/web": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "@powersync/web": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.3.4"
}
